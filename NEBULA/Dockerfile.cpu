# Common dependency layer shared by all three NEBULA components.
FROM python:3.11-slim-bookworm AS base
ENV DEBIAN_FRONTEND=noninteractive \
    TZ=America/Bogota \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH=/opt/venv/bin:$PATH \
    OMP_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    UV_CONCURRENT_DOWNLOADS=2 \
    UV_CONCURRENT_BUILDS=1
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash ca-certificates curl git build-essential nginx iproute2 iputils-ping \
    net-tools libglib2.0-0 libgomp1 libgl1 tzdata \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir uv==0.8.22
WORKDIR /opt/build
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --python /usr/local/bin/python3.11 --no-install-project --no-dev \
    --group core --group controller --group frontend
RUN python -c "import torch,numpy,opacus,sklearn; assert torch.version.cuda is None; torch.from_numpy(numpy.zeros(1)); print('CPU dependency smoke check passed:',torch.__version__)"
WORKDIR /

FROM base AS core

FROM base AS controller
COPY nebula/controller/start_services.sh /start_services.sh
ENTRYPOINT ["bash", "/start_services.sh"]

FROM base AS frontend
COPY nebula/frontend/start_services.sh /start_services.sh
ENTRYPOINT ["bash", "/start_services.sh"]
